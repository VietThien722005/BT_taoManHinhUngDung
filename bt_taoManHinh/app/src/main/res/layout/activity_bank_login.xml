<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="20dp"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <TextView android:text="Bank Login" android:textSize="20sp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <EditText android:hint="Username" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:hint="Password" android:inputType="textPassword" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/btnBankLogin" android:text="Login Bank" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
