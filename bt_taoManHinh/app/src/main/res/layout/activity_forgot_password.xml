<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView android:text="Forgot Password" android:textSize="20sp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <EditText android:hint="Enter your email" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/btnReset" android:text="Reset Password" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
